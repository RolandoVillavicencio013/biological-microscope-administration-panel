@inherits LayoutComponentBase
@using UCR.EB.BioMicroscopeAdmin.Frontend.Presentation.Theme

<MudThemeProvider Theme="@UcrTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6">Panel de gestión del Microscopio Virtual</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="d-none d-sm-flex">Universidad de Costa Rica</MudText>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <MudDrawerHeader Class="d-flex justify-center py-6">
            <img src="images/ucr-logo.png" alt="Universidad de Costa Rica" style="max-width: 170px; width: 100%;" />
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
