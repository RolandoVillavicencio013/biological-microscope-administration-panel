@page "/slides"
@inject ISlideService SlideService
@inject IBoxService BoxService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Láminas</PageTitle>

<MudTable ServerData="ServerReload" @ref="_table" RowsPerPage="20" Loading="_loading" Hover="true" Bordered="true" Striped="true">
    <ToolBarContent>
        <MudText Typo="Typo.h5">Láminas</MudText>
        <MudSpacer />
        <MudTextField T="string" @bind-Value="_searchText" Immediate="true" DebounceInterval="400"
                       OnDebounceIntervalElapsed="OnSearchChanged" Label="Buscar por código o nombre"
                       Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true"
                       Style="max-width:280px" Class="mr-4" Variant="Variant.Outlined" />
        <MudSelect T="int?" Value="_filterBoxId" ValueChanged="OnFilterChanged" Label="Filtrar por caja"
                   Clearable="true" Style="max-width:220px" Class="mr-4" Variant="Variant.Outlined">
            @foreach (var b in _boxes)
            {
                <MudSelectItem T="int?" Value="b.Id">@b.Number - @b.Name</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">
            Nueva Lámina
        </MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Código</MudTh>
        <MudTh>Nombre</MudTh>
        <MudTh>Caja</MudTh>
        <MudTh Style="text-align:right">Acciones</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Código">@context.Code</MudTd>
        <MudTd DataLabel="Nombre">@context.Name</MudTd>
        <MudTd DataLabel="Caja">@BoxName(context.BoxId)</MudTd>
        <MudTd Style="text-align:right">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small"
                           OnClick="@(() => ViewDetail(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                           OnClick="@(() => Delete(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No hay láminas registradas.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager RowsPerPageString="Filas por página:" InfoFormat="{first_item}-{last_item} de {all_items}"
                       AllItemsText="Todos" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<SlideDto> _table = null!;
    private List<BoxDto> _boxes = [];
    private int? _filterBoxId;
    private string _searchText = "";
    private bool _loading;

    protected override async Task OnInitializedAsync() => await LoadBoxes();

    private async Task LoadBoxes()
    {
        try { _boxes = await BoxService.ListAllAsync(); }
        catch (Exception ex) { Snackbar.Add($"Error al cargar cajas: {ex.Message}", Severity.Error); }
    }

    private async Task<TableData<SlideDto>> ServerReload(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await SlideService.SearchAsync(_searchText, _filterBoxId, state.Page + 1, state.PageSize);
            return new TableData<SlideDto> { TotalItems = result.TotalCount, Items = result.Items };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar láminas: {ex.Message}", Severity.Error);
            return new TableData<SlideDto> { TotalItems = 0, Items = [] };
        }
        finally { _loading = false; }
    }

    private async Task OnFilterChanged(int? value)
    {
        _filterBoxId = value;
        await _table.ReloadServerData();
    }

    private async Task OnSearchChanged(string value)
    {
        _searchText = value;
        await _table.ReloadServerData();
    }

    private string BoxName(int boxId)
    {
        var b = _boxes.FirstOrDefault(x => x.Id == boxId);
        return b is null ? boxId.ToString() : $"{b.Number} - {b.Name}";
    }

    private void ViewDetail(SlideDto slide) => Nav.NavigateTo($"/slides/{slide.Id}");

    private async Task OpenCreate()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<SlideFormDialog>("Nueva Lámina", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is int slideId)
        {
            Nav.NavigateTo($"/slides/{slideId}");
        }
    }

    private async Task Delete(SlideDto slide)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.Message, $"¿Eliminar la lámina \"{slide.Name}\"?" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Confirmar eliminación", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                await SlideService.DeleteAsync(slide.Id);
                Snackbar.Add("Lámina eliminada.", Severity.Success);
                await _table.ReloadServerData();
            }
            catch (Exception ex) { Snackbar.Add($"Error al eliminar lámina: {ex.Message}", Severity.Error); }
        }
    }
}
